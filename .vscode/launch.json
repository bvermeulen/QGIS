    "version": "0.2.0",
    "configurations": [
        {
            "name": "Remote Attach",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}/QGIS/plugins",
                    "remoteRoot": "/home/bvermeulen/.local/share/QGIS/QGIS3/profiles/default/python/plugins"
                }
            ]
        },
        {
            "name": "Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
    ]
}
